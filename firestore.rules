rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Each Google account can access only its own saved race IDs.
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validDocument() {
        return request.resource.data.keys().hasOnly(['followedRaces'])
          && request.resource.data.keys().hasAll(['followedRaces'])
          && request.resource.data.followedRaces is list;
      }

      allow read: if owner();
      allow create: if owner() && validDocument()
        && request.resource.data.followedRaces.size() <= 50;

      allow update: if owner() && validDocument() && (
        request.resource.data.followedRaces.size() <= 50
        // If an existing account followed 51+ races before this change,
        // preserve its data and allow ONLY removals until it drops to 50.
        || (
          resource.data.followedRaces is list
          && resource.data.followedRaces.size() > 50
          && request.resource.data.followedRaces.size() < resource.data.followedRaces.size()
          && request.resource.data.followedRaces.hasOnly(resource.data.followedRaces)
        )
      );
      allow delete: if owner();
    }
  }
}
