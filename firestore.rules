rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in account can only read/write its own followed race IDs.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['followedRaces'])
        && request.resource.data.followedRaces is list
        && request.resource.data.followedRaces.size() <= 500;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
